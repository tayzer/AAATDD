<Project Sdk="MSTest.Sdk/4.5.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework><OutputType>Exe</OutputType><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <TestingExtensionsProfile>None</TestingExtensionsProfile><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ReqnrollUseIntermediateOutputPathForCodeBehind>true</ReqnrollUseIntermediateOutputPathForCodeBehind>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Reqnroll.MSTest" Version="[3.3.4]" />
    <PackageReference Include="Reqnroll" Version="[3.3.4]" />
    <PackageReference Include="Reqnroll.Tools.MsBuild.Generation" Version="[3.3.4]" />
    <None Update="reqnroll.json" CopyToOutputDirectory="PreserveNewest" />
    <ReqnrollFeatureFile Include="../features/*.feature" Link="Features/%(Filename)%(Extension)" />
  </ItemGroup>
  <Import Project="../Support/Services.props" />
</Project>
